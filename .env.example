# ===== Menorcost - variables de demo/servidor (Opcion 1: Docker + Caddy + Tailscale Funnel) =====
# Copia este archivo a .env y completa los valores. NO commitees .env con secretos.
# FQDN de ejemplo para esta demo: menorcostserver.tail67d69c.ts.net

# --- PostgreSQL (contenedor) ---
DB_USER=postgres
DB_PASSWORD=cambia_esta_password_segura
DB_NAME=menorcost
# Puerto expuesto en el host solo para debug local (opcional; el backend en Docker usa la red interna)
DB_LOCAL_PORT=5433

# --- URL publica (Tailscale Funnel) y CORS / mismo origen ---
# VITE_API_URL se incrusta en el build del frontend: cambiarla requiere reconstruir el frontend.
VITE_API_URL=https://menorcostserver.tail67d69c.ts.net/api
FRONTEND_URL=https://menorcostserver.tail67d69c.ts.net
CORS_ORIGIN=https://menorcostserver.tail67d69c.ts.net

# El mapa usa tiles raster públicos de CARTO: no necesita API key.

# --- Backend: puerto y archivos ---
PORT=3000
UPLOAD_DIR=/app/uploads

# --- Auth / correo ---
JWT_SECRET=cambia_este_jwt_secret_largo_y_aleatorio
# console = codigos de verificacion en logs del backend (recomendado para demo)
MAIL_PROVIDER=console
MAIL_FROM=Menorcost <no-reply@menorcost.local>
# Solo si MAIL_PROVIDER=smtp
# MAIL_HOST=
# MAIL_PORT=587
# MAIL_SECURE=false
# MAIL_USER=
# MAIL_PASSWORD=

# --- Mercado Pago ---
# Client ID y Client Secret se toman del panel de la app (necesarios para OAuth).
# Para cobrar con cuentas/saldo de prueba, deja MP_TEST_TOKEN=true: el token emitido
# será sandbox aunque las credenciales del panel sean de producción.
MP_CLIENT_ID=
MP_CLIENT_SECRET=
# Debe coincidir exactamente con la URL registrada en la app de MP.
MP_REDIRECT_URI=https://menorcostserver.tail67d69c.ts.net/api/mercadopago/oauth/callback
MP_OAUTH_STATE_SECRET=cambia_este_state_secret_largo
# Clave de 32 bytes para cifrar tokens (hex de 64 chars o base64 de 32 bytes)
MP_TOKENS_ENCRYPTION_KEY=
# MP exige PKCE en el intercambio OAuth.
MP_PKCE_ENABLED=true
MP_TEST_TOKEN=true
MP_TIMEOUT_MS=10000
# Base pública HTTPS del backend INCLUYENDO /api. MP llama a ${MP_URL_PUBLICA}/notificaciones-mercadopago
MP_URL_PUBLICA=https://menorcostserver.tail67d69c.ts.net/api
MP_WEBHOOK_SECRET=
# Opcionales: reserva de stock y gracia antes de cancelar pedidos impagos
PAGOS_MINUTOS_EXPIRACION=60
PAGOS_MINUTOS_GRACIA=5

# --- Integraciones opcionales ---
# GOOGLE_PLACES_API_KEY=
