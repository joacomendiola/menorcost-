# Backend Menorcost - ejemplo para ejecucion en Docker (red interna)
# En Docker Compose, DATABASE_URL se inyecta normalmente desde el servicio; puedes dejar este valor como referencia.
DATABASE_URL=postgresql://postgres:cambia_esta_password_segura@postgres:5432/menorcost?schema=public

PORT=3000
UPLOAD_DIR=/app/uploads
TZ=America/Argentina/Ushuaia

JWT_SECRET=cambia_este_jwt_secret_largo_y_aleatorio
FRONTEND_URL=https://menorcostserver.tail67d69c.ts.net
CORS_ORIGIN=https://menorcostserver.tail67d69c.ts.net

# Correo: console imprime codigos en logs (demo)
MAIL_PROVIDER=console
MAIL_FROM=Menorcost <no-reply@menorcost.local>
# MAIL_PROVIDER=smtp
# MAIL_HOST=
# MAIL_PORT=587
# MAIL_SECURE=false
# MAIL_USER=
# MAIL_PASSWORD=

# Mercado Pago
# Client ID y Client Secret del panel de la app (necesarios para OAuth).
# MP_TEST_TOKEN=true emite tokens sandbox para probar con cuentas/saldo de prueba.
MP_CLIENT_ID=
MP_CLIENT_SECRET=
# Debe coincidir exactamente con la URL registrada en la app de MP.
MP_REDIRECT_URI=https://menorcostserver.tail67d69c.ts.net/api/mercadopago/oauth/callback
MP_OAUTH_STATE_SECRET=cambia_este_state_secret_largo
MP_TOKENS_ENCRYPTION_KEY=
# MP exige PKCE en el intercambio OAuth.
MP_PKCE_ENABLED=true
MP_TEST_TOKEN=true
MP_TIMEOUT_MS=10000
# Base pública HTTPS del backend INCLUYENDO /api. MP llama a ${MP_URL_PUBLICA}/notificaciones-mercadopago
MP_URL_PUBLICA=https://menorcostserver.tail67d69c.ts.net/api
MP_WEBHOOK_SECRET=
# Opcionales: reserva de stock y gracia antes de cancelar pedidos impagos
PAGOS_MINUTOS_EXPIRACION=60
PAGOS_MINUTOS_GRACIA=5

# Integraciones opcionales
# GOOGLE_PLACES_API_KEY=
