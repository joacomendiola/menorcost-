// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Modelo de Producto

enum TipoProducto {
  INDIVIDUAL
  COMBO
}

enum EstadoProducto {
  ACTIVO
  PAUSADO
  VENCIDO_ELIMINADO
  ELIMINADO
}

model Producto {
  idProducto       String         @id @default(uuid()) @map("id_producto") @db.Uuid
  comercioId       String         @map("id_comercio") @db.Uuid
  categoriaId      String         @map("id_categoria") @db.Uuid
  tipo             TipoProducto   @default(INDIVIDUAL)
  titulo           String         @db.VarChar(120)
  descripcion      String         @db.Text
  fechaVencimiento DateTime       @map("fecha_vencimiento") @db.Date
  stock            Int
  precioLista      Decimal        @map("precio_lista") @db.Decimal(10, 2)
  precioMenorcost  Decimal        @map("precio_menorcost") @db.Decimal(10, 2)
  imagen           String         @db.VarChar(500)
  estado           EstadoProducto @default(ACTIVO)

  comercio         Comercio       @relation(fields: [comercioId], references: [idComercio])
  categoria        Categoria      @relation(fields: [categoriaId], references: [idCategoria])

  @@map("producto")
}

// CLASES MINIMAS PARA LA COMPILACION DE LA RELACIONES DEL MODEL PRODUCTO (ELIMINAR EN CUANTO SE HAGA EL PR QUE CONTENGA LOS MODEL COMPLETOS)
model Comercio {
  idComercio           String     @id @default(uuid()) @map("id_comercio") @db.Uuid
  usuarioId            String     @unique @map("usuario_id")
  mercadoPagoVinculado Boolean    @default(false) @map("mercado_pago_vinculado")
  reputacionPromedio   Float      @default(0) @map("reputacion_promedio")
  totalCalificaciones  Int        @default(0) @map("total_calificaciones")
  usuario              Usuario    @relation(fields: [usuarioId], references: [id])
  productos            Producto[]

  @@map("comercio")
}

model Categoria {
  idCategoria String     @id @default(uuid()) @map("id_categoria") @db.Uuid
  productos    Producto[]

  @@map("categoria")
}
enum Rol {
  CLIENTE
  COMERCIANTE
  ADMINISTRADOR
}

enum EstadoUsuario {
  HABILITADO
  PENDIENTE_VERIFICACION
  SUSPENDIDO
  SOLICITUD_BAJA_PENDIENTE
  BAJO_INVESTIGACION
  DOCUMENTACION_RECHAZADA
}

enum TipoCodigo {
  VERIFICACION_EMAIL
  RECUPERACION_PASSWORD
}

enum EstadoSolicitudBaja {
  PENDIENTE
  APROBADA
  RECHAZADA
}

model Usuario {
  id             String        @id @default(uuid())
  dni            String        @unique
  nombre         String
  apellido       String
  email          String        @unique
  telefono       String
  fechaNacimiento DateTime
  passwordHash   String
  rol            Rol           @default(CLIENTE)
  estado         EstadoUsuario @default(PENDIENTE_VERIFICACION)
  tokenVersion   Int           @default(0)
  deletedAt      DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  direcciones Direccion[]
  codigos     CodigoSeguridad[]
  pedidos Pedido[]

  // TODO integración: adaptar si el modelo real permite varios comercios
  // por usuario o define esta relación desde el módulo de comercios.
  comercio Comercio?

  solicitudesBaja SolicitudBaja[] @relation("BajaSolicitada")
  bajasResueltas  SolicitudBaja[] @relation("BajaResuelta")

  reportesEmitidos   Reporte[] @relation("ReportesEmitidos")
  reportesRecibidos  Reporte[] @relation("ReportesRecibidos")
  reportesSupervisados Reporte[] @relation("ReportesSupervisados")

  @@map("usuarios")
}

model Direccion {
  id              String   @id @default(uuid())
  usuarioId       String
  etiqueta        String
  calle           String
  numero          String
  piso            String?
  localidad       String
  descripcion     String?
  latitud         Decimal  @db.Decimal(9, 6)
  longitud        Decimal  @db.Decimal(9, 6)
  esPredeterminada Boolean @default(false)
  deletedAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@map("direcciones")
}

model CodigoSeguridad {
  id         String     @id @default(uuid())
  usuarioId  String
  tipo       TipoCodigo
  codigoHash String
  expiraEn   DateTime
  usadoEn    DateTime?
  createdAt  DateTime   @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId, tipo])
  @@index([codigoHash])
  @@map("codigos_seguridad")
}

model SolicitudBaja {
  id            String               @id @default(uuid())
  usuarioId     String
  motivo        String
  estado        EstadoSolicitudBaja  @default(PENDIENTE)
  observaciones String?
  resueltoPorId String?
  resueltoEn    DateTime?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  usuario     Usuario  @relation("BajaSolicitada", fields: [usuarioId], references: [id], onDelete: Cascade)
  resueltoPor Usuario? @relation("BajaResuelta", fields: [resueltoPorId], references: [id])

  @@index([usuarioId])
  @@index([estado])
  @@map("solicitudes_baja")
}

//Dev 5: faltaria crear modelo pedido para Calificacion y Reporte

enum EstadoReporte {
  PENDIENTE_REVISION 
  BAJO_INVESTIGACION 
  RESUELTO           
  DESESTIMADO        
}

enum TipoDestinoReporte {
  COMERCIO
  CLIENTE
}

model Calificacion {
  id_calificacion Int      @id @default(autoincrement())
  puntaje         Int      // Escala obligatoria de 1 a 5
  comentario      String?  @db.VarChar(250) // Máximo 250 caracteres según CU-5.01
  fecha_creacion  DateTime @default(now())  // Necesario para mostrar por ej:"02 sep" en Pantalla

  // Relación 1 a 1 con Pedido (Pedido --(0,1)Genera/(1,1)--> Calificacion)
  id_pedido       String   @unique
  pedido          Pedido   @relation(fields: [id_pedido], references: [id_pedido])
   
  @@map("calificacion") 
}

model Reporte {
  id_reporte      Int                @id @default(autoincrement())
  motivo          String             // Categoría seleccionada en el select
  descripcion     String?            @db.VarChar(300) // Máximo 300 caracteres según CU-5.02
  estado_reporte  EstadoReporte      @default(PENDIENTE_REVISION)
  tipo_destino    TipoDestinoReporte // Hacia quién va dirigida la denuncia
  fecha_reporte   DateTime           @default(now())
  fecha_resolucion DateTime?

  // Relación con Pedido (En el DER: Reporte --Referencia (1,1)--> Pedido)
  id_pedido       String
  pedido          Pedido             @relation(fields: [id_pedido], references: [id_pedido])

  // Relación Usuario Emite Reporte (1,n)
  id_emisor       String
  emisor          Usuario            @relation("ReportesEmitidos", fields: [id_emisor], references: [id])

  // Usuario o Comercio denunciado (Requerido por CU-5.02 para contar el umbral de 3 reportes)
  id_denunciado   String
  denunciado      Usuario            @relation("ReportesRecibidos", fields: [id_denunciado], references: [id])

  // Relación Usuario (Admin) Supervisa Reporte (0,n) 
  id_admin        String?
  admin           Usuario?            @relation("ReportesSupervisados", fields: [id_admin], references: [id])

  @@map("reporte")
}

// modelo temporal de Pedido (A reemplazar cuando dev 4 lo suba)
model Pedido {
  id_pedido     String        @id @default(uuid()) 
  comercioId    String        @db.Uuid
  estado        String
  usuarioId     String

  usuario       Usuario       @relation(fields: [usuarioId], references: [id])
  calificacion  Calificacion?
  reportes      Reporte[]

  @@map("pedido")
}