model HorarioAtencion {
  id         String   @id @default(uuid()) @db.Uuid
  comercioId String   @map("comercio_id") @db.Uuid
  diaSemana  Int      @map("dia_semana")
  horaInicio String   @map("hora_inicio") @db.VarChar(5)
  horaFin    String   @map("hora_fin") @db.VarChar(5)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  comercio Comercio @relation(fields: [comercioId], references: [idComercio], onDelete: Cascade)

  @@index([comercioId, diaSemana])
  @@map("horario_atencion")
}

model FranjaRetiro {
  id         String   @id @default(uuid()) @db.Uuid
  comercioId String   @map("comercio_id") @db.Uuid
  diaSemana  Int      @map("dia_semana")
  horaInicio String   @map("hora_inicio") @db.VarChar(5)
  horaFin    String   @map("hora_fin") @db.VarChar(5)
  activa     Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  comercio Comercio @relation(fields: [comercioId], references: [idComercio], onDelete: Cascade)

  @@index([comercioId, diaSemana])
  @@map("franja_retiro")
}

model Categoria {
  idCategoria String   @id @default(uuid()) @map("id_categoria") @db.Uuid
  nombre      String   @unique @db.VarChar(80)
  slug        String   @unique @db.VarChar(80)
  orden       Int      @default(0)
  activa      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  productos Producto[]

  @@map("categoria")
}
enum Rol {
  CLIENTE
  COMERCIANTE
  ADMINISTRADOR
}

enum EstadoUsuario {
  HABILITADO
  PENDIENTE_VERIFICACION
  SUSPENDIDO
  SOLICITUD_BAJA_PENDIENTE
  BAJO_INVESTIGACION
  DOCUMENTACION_RECHAZADA
}

enum TipoCodigo {
  VERIFICACION_EMAIL
  RECUPERACION_PASSWORD
}

enum EstadoSolicitudBaja {
  PENDIENTE
  APROBADA
  RECHAZADA
}

model Usuario {
  id             String        @id @default(uuid())
  dni            String        @unique
  nombre         String
  apellido       String
  email          String        @unique
  telefono       String
  fechaNacimiento DateTime
  passwordHash   String
  rol            Rol           @default(CLIENTE)
  estado         EstadoUsuario @default(PENDIENTE_VERIFICACION)
  tokenVersion   Int           @default(0)
  deletedAt      DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  direcciones Direccion[]
  codigos     CodigoSeguridad[]
  pedidos Pedido[]

  // TODO integración: adaptar si el modelo real permite varios comercios
  // por usuario o define esta relación desde el módulo de comercios.
  comercio Comercio?

  solicitudesBaja SolicitudBaja[] @relation("BajaSolicitada")
  bajasResueltas  SolicitudBaja[] @relation("BajaResuelta")

  reportesEmitidos   Reporte[] @relation("ReportesEmitidos")
  reportesRecibidos  Reporte[] @relation("ReportesRecibidos")
  reportesSupervisados Reporte[] @relation("ReportesSupervisados")

  @@map("usuarios")
}

model Direccion {
  id              String   @id @default(uuid())
  usuarioId       String
  etiqueta        String
  calle           String
  numero          String
  piso            String?
  localidad       String
  descripcion     String?
  latitud         Decimal  @db.Decimal(9, 6)
  longitud        Decimal  @db.Decimal(9, 6)
  esPredeterminada Boolean @default(false)
  deletedAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@map("direcciones")
}

model CodigoSeguridad {
  id         String     @id @default(uuid())
  usuarioId  String
  tipo       TipoCodigo
  codigoHash String
  expiraEn   DateTime
  usadoEn    DateTime?
  createdAt  DateTime   @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId, tipo])
  @@index([codigoHash])
  @@map("codigos_seguridad")
}

model SolicitudBaja {
  id            String               @id @default(uuid())
  usuarioId     String
  motivo        String
  estado        EstadoSolicitudBaja  @default(PENDIENTE)
  observaciones String?
  resueltoPorId String?
  resueltoEn    DateTime?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  usuario     Usuario  @relation("BajaSolicitada", fields: [usuarioId], references: [id], onDelete: Cascade)
  resueltoPor Usuario? @relation("BajaResuelta", fields: [resueltoPorId], references: [id])

  @@index([usuarioId])
  @@index([estado])
  @@map("solicitudes_baja")
}

//Dev 5: faltaria crear modelo pedido para Calificacion y Reporte

enum EstadoReporte {
  PENDIENTE_REVISION 
  BAJO_INVESTIGACION 
  RESUELTO           
  DESESTIMADO        
}

enum TipoDestinoReporte {
  COMERCIO
  CLIENTE
}

model Calificacion {
  id_calificacion Int      @id @default(autoincrement())
  puntaje         Int      // Escala obligatoria de 1 a 5
  comentario      String?  @db.VarChar(250) // Máximo 250 caracteres según CU-5.01
  fecha_creacion  DateTime @default(now())  // Necesario para mostrar por ej:"02 sep" en Pantalla

  // Relación 1 a 1 con Pedido (Pedido --(0,1)Genera/(1,1)--> Calificacion)
  id_pedido       String   @unique   @db.Uuid
  pedido          Pedido   @relation(fields: [id_pedido], references: [id_pedido])
   
  @@map("calificacion") 
}

model Reporte {
  id_reporte      Int                @id @default(autoincrement())
  motivo          String             // Categoría seleccionada en el select
  descripcion     String?            @db.VarChar(300) // Máximo 300 caracteres según CU-5.02
  estado_reporte  EstadoReporte      @default(PENDIENTE_REVISION)
  tipo_destino    TipoDestinoReporte // Hacia quién va dirigida la denuncia
  fecha_reporte   DateTime           @default(now())
  fecha_resolucion DateTime?

  // Relación con Pedido (En el DER: Reporte --Referencia (1,1)--> Pedido)
  id_pedido       String             @db.Uuid
  pedido          Pedido             @relation(fields: [id_pedido], references: [id_pedido])

  // Relación Usuario Emite Reporte (1,n)
  id_emisor       String
  emisor          Usuario            @relation("ReportesEmitidos", fields: [id_emisor], references: [id])

  // Usuario o Comercio denunciado (Requerido por CU-5.02 para contar el umbral de 3 reportes)
  id_denunciado   String
  denunciado      Usuario            @relation("ReportesRecibidos", fields: [id_denunciado], references: [id])

  // Relación Usuario (Admin) Supervisa Reporte (0,n) 
  id_admin        String?
  admin           Usuario?            @relation("ReportesSupervisados", fields: [id_admin], references: [id])

  @@map("reporte")
}

//Modelo Pedido completo del DEV4(en caso de reemplazar o modificar tener cuidado)
model Pedido {
  id_pedido       String         @id @default(uuid()) @map("id_pedido") @db.Uuid
  usuarioId       String         @map("usuario_id")
  comercioId      String         @map("id_comercio") @db.Uuid
  estado          EstadoPedido   @default(PENDIENTE_DE_RETIRO)
  codigoQR        String         @unique @map("codigo_qr") @db.VarChar(100)
  codigoAlfanumerico String      @unique @map("codigo_alfanumerico") @db.VarChar(20)
  fecha_pedido    DateTime       @default(now()) @map("fecha_pedido") @db.Timestamp(0)
  franjaHorarioId String?        @map("franja_horario_id") @db.Uuid
  subtotal        Decimal        @db.Decimal(10, 2)
  tarifa_servicio Decimal        @map("tarifa_servicio") @db.Decimal(10, 2)
  total           Decimal        @db.Decimal(10, 2)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  usuario         Usuario        @relation(fields: [usuarioId], references: [id])
  comercio        Comercio       @relation(fields: [comercioId], references: [idComercio])
  calificacion    Calificacion?
  reportes        Reporte[]
  items           PedidoItem[]

  @@map("pedido")
}

model PedidoItem {
  id_pedido_item String   @id @default(uuid()) @map("id_pedido_item") @db.Uuid
  pedidoId       String   @map("id_pedido") @db.Uuid
  productoId     String   @map("id_producto") @db.Uuid
  cantidad       Int
  precio_unitario Decimal  @map("precio_unitario") @db.Decimal(10, 2)
  subtotal       Decimal  @db.Decimal(10, 2)

  pedido         Pedido   @relation(fields: [pedidoId], references: [id_pedido])
  producto       Producto @relation(fields: [productoId], references: [idProducto])

  @@map("pedido_item")
}

enum EstadoPedido {
  PENDIENTE_DE_RETIRO
  ENTREGADO
  CANCELADO
  CANCELADO_POR_FALTA_RETIRO
}